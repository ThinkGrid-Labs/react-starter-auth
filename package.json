{
  "name": "@think-grid-labs/react-starter-auth",
  "version": "0.1.0",
  "description": "React Next Starter Authentication",
  "keywords": [
    "reactjs",
    "nextjs",
    "authentication",
    "jwt"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
