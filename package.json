{
  "name": "@thinkgrid/react-starter-auth",
  "version": "1.0.1",
  "description": "Secure JWT authentication for React and Next.js — HttpOnly server sessions, verified tokens, CSRF built in.",
  "keywords": [
    "react",
    "nextjs",
    "authentication",
    "auth",
    "jwt",
    "session",
    "httponly",
    "cookie",
    "csrf",
    "jose",
    "bff",
    "react-router",
    "remix",
    "ssr"
  ],
  "license": "MIT",
  "author": "Dennis Paler <dennis@thinkgrid.dev>",
  "homepage": "https://github.com/thinkgrid-labs/react-starter-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkgrid-labs/react-starter-auth.git"
  },
  "bugs": {
    "url": "https://github.com/thinkgrid-labs/react-starter-auth/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "source": "src/index.tsx",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs",
      "default": "./dist/core.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "default": "./dist/server.mjs"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs",
      "default": "./dist/next.mjs"
    },
    "./react-router": {
      "types": "./dist/adapters/react-router.d.ts",
      "import": "./dist/react-router.mjs",
      "require": "./dist/react-router.cjs",
      "default": "./dist/react-router.mjs"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s build:clean build:bundle",
    "build:clean": "rimraf ./dist",
    "build:bundle": "rollup -c",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "run-s lint typecheck test:unit",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "preversion": "run-s test",
    "prepublishOnly": "run-s test build",
    "release": "release-it",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "29.5.5",
    "@types/node": "20.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "6.8.0",
    "@typescript-eslint/parser": "6.8.0",
    "eslint": "8.50.0",
    "eslint-config-google": "0.14.0",
    "eslint-plugin-jest": "27.4.2",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.4.3",
    "lefthook": "^1.6.1",
    "npm-run-all": "4.1.5",
    "prettier": "^3.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^21.0.2",
    "rimraf": "5.0.5",
    "rollup": "^4.1.5",
    "rollup-plugin-filesize": "10.0.0",
    "rollup-plugin-license": "^3.2.0",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "29.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
